# Local development: copy this file to .env (never commit .env).
# On Azure, configure these through App Service Environment variables / Key Vault.
NODE_ENV=development
PORT=3000
APP_ORIGIN=http://localhost:3000
INSTITUTION_NAME=Your institution

# Local PostgreSQL only. Azure must set DATABASE_TLS=true.
DATABASE_URL=postgresql://teamup:local-development-only@localhost:5432/teamup
DATABASE_TLS=false
# Optional path to an institution-approved PostgreSQL CA certificate bundle:
DATABASE_CA_FILE=

# Your single-tenant Microsoft Entra WEB application registration:
ENTRA_TENANT_ID=00000000-0000-4000-8000-000000000001
ENTRA_CLIENT_ID=00000000-0000-4000-8000-000000000002
ENTRA_CLIENT_SECRET=replace-locally-do-not-commit
REQUIRED_ENTRA_ROLE=TeamUp.User
ADMIN_ENTRA_ROLE=TeamUp.Admin
SESSION_HOURS=8
TRUST_PROXY_HOPS=0

# Optional source link, not an automatic Power BI API connection.
FUNDING_CALENDAR_URL=

# Explicit loopback-only helper for local UI testing; always false on Azure.
ENABLE_DEV_LOGIN=false
